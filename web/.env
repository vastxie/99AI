# 本地链接生产
# VITE_GLOB_API_URL=https://xxx.com/api

# 本地
VITE_GLOB_API_URL=http://localhost:9520/api


# 如需本地走 Vite proxy，可改为 /api
# VITE_GLOB_API_URL=/api
# 生产
# VITE_GLOB_API_URL=https://example.com/api

# 商业化 UI 开关（会员 / 积分 / 套餐 / 支付 / 每日签到 / 微信 Bot 绑定等入口）
# 默认 true；设为 false / 0 / off / no 时构建产物隐藏这些入口（组件代码仍保留，见 src/packs/commerce）
VITE_COMMERCE_ENABLED=true

# 微信包 UI 开关（公众号扫码 / 开放平台登录面板 / 微信 Bot 入口），对应后端 WECHAT_PACK_ENABLED；默认 true
VITE_WECHAT_ENABLED=true

# GitHub 登录包 UI 开关，对应后端 GITHUB_PACK_ENABLED；默认 true
VITE_GITHUB_ENABLED=true

# 富媒体渲染包（思维导图 / Mermaid / HTML 预览 / CodeMirror 代码面板 / PDF、Office 预览）；只有取值为 false 时关闭
VITE_RICH_MEDIA_ENABLED=true

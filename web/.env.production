# 本地链接生产
# VITE_GLOB_API_URL=https://xxx.com/api

# 本地
VITE_GLOB_API_URL=/api

# 生产
# VITE_GLOB_API_URL=https://example.com/api

# 商业化 UI 开关：默认沿用 .env 的 true；不需要商业功能的站点可在此覆盖为 false，隐藏会员 / 支付 / 签到入口
# VITE_COMMERCE_ENABLED=false
# 微信包 UI 开关；关闭后端微信包时同步设为 false
# VITE_WECHAT_ENABLED=false
# GitHub 登录包 UI 开关；关闭后端 GitHub 包时同步设为 false
# VITE_GITHUB_ENABLED=false
# 富媒体渲染包：设为 false 时相关依赖不进入构建产物
# VITE_RICH_MEDIA_ENABLED=false


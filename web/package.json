{
  "name": "99agent-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.1.3",
  "description": "99Agent web client",
  "author": "vastxie",
  "keywords": [
    "99agent",
    "agent",
    "chat"
  ],
  "scripts": {
    "start:h": "pnpm run -C ../server dev",
    "start:f": "vite",
    "all": "npm-run-all --parallel start:h start:f",
    "dev": "vite",
    "build-check": "run-s type-check build-only",
    "preview": "vite preview",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build --mode=production",
    "test": "vitest run",
    "e2e": "playwright test",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src",
    "check:design": "node scripts/check-design-guidelines.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "doctor": "vue-doctor . --verbose",
    "format": "prettier --write '{src,scripts,config}/**/*.{vue,ts,tsx,mts,js,jsx,css,scss,less,json,md,html,yml,yaml}' '*.{js,ts,mts,json,md,yml}'"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.3",
    "markdown-it-link-attributes": "^4.0.1",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@healerlab/vue-doctor": "0.0.4",
    "@playwright/test": "^1.64.1",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "20.14.5",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "license": "Apache-2.0"
}

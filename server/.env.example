# 端口
PORT=9520

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_DATABASE=99agent
# 先对全新空库运行 node dist/main db:init；正常启动只校验当前基线，不自动改表

# Redis
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0

# 是否测试环境
ISDEV=false
# 运行环境：生产部署请显式声明 production（pm2.conf.json 已带）。未设置时安全默认值一律按生产处理。
# 开发模式要同时满足：NODE_ENV 不是 production、ISDEV 不是 false，并且 ISDEV=true 或 NODE_ENV=development / test；
# 只有开发模式才会放宽 bcrypt 强度、localhost 跨域、local 沙箱驱动与非 runsc 运行时。本机试用可改为 ISDEV=true、NODE_ENV=development。
NODE_ENV=production

# JWT 签名密钥（至少 32 位）。留空则首次启动自动生成并存入 Redis；多实例部署或需要轮换时请显式配置。
JWT_SECRET=
# 首次初始化超级管理员 super 的密码（8 – 30 个字符：上限与登录密码一致，下限比登录更严）。留空则随机生成并写入 ADMIN_INITIAL_PASSWORD_FILE（默认 storage/initial-admin-password.txt），
# 登录后请立即修改密码并删除该文件；文件写好之后才创建账号，创建失败重启时沿用同一个密码，服务不会删除或覆盖它。
ADMIN_INITIAL_PASSWORD=
# 随机初始密码的写入路径（默认 storage/initial-admin-password.txt）
ADMIN_INITIAL_PASSWORD_FILE=

# 商业包开关：积分 / 套餐 / 订单 / 支付 / 签到。默认启用；
# 设为 false 时整包不装载，内核以空计费（NoopBillingService）运行，相关后台接口返回 501。
COMMERCE_PACK_ENABLED=true
# 内容安全包开关：敏感词库 / 白名单 / 违规记录 / 腾讯云文本审核。默认启用；
# 设为 false 时整包不装载，内核以直通内容过滤（永不命中）运行，管理端安全风控接口不再注册。
CONTENT_SAFETY_PACK_ENABLED=true
# 微信包开关：公众号（扫码登录 / 微信内授权 / 消息推送）/ 微信开放平台网站登录 / 微信 Bot 通道 / 用户渠道绑定。默认启用；
# 设为 false 时整包不装载，登录方式列表不再出现任何微信登录，内核视为没有任何渠道绑定，管理端微信配置与 Bot 通道接口不再注册。
WECHAT_PACK_ENABLED=true
# 进程外渠道服务的服务端令牌：渠道服务调用 /api/channel-gateway/* 时放在 x-channel-service-token 头；
# 未配置时这些接口返回 503。
CHANNEL_SERVICE_TOKEN=
# 登录渠道包开关（一个渠道一个包，默认全部启用）：
# 邮箱包：邮箱验证码登录 / 绑定 / 找回密码，SMTP 或腾讯云邮件发信；
# 手机号包：手机号验证码登录 / 绑定 / 找回密码，腾讯云短信；
# GitHub 包：GitHub OAuth 登录 / 绑定。
# 全部关闭时内核只剩账号密码注册与登录（后台可用 passwordRegisterStatus 关闭自助注册）。
EMAIL_PACK_ENABLED=true
PHONE_PACK_ENABLED=true
GITHUB_PACK_ENABLED=true
# 模型协议包开关（默认全部启用）：内核只自带 OpenAI Chat Completions / 兼容接口；
# 关闭后对应协议的适配器、厂商预设与模型目录不装载，已配置为该协议的模型无法调用。
MODEL_OPENAI_RESPONSES_PACK_ENABLED=true
MODEL_ANTHROPIC_PACK_ENABLED=true
MODEL_GEMINI_PACK_ENABLED=true
MODEL_OPENCODE_GO_PACK_ENABLED=true
# 存储包开关（默认全部启用）：内核只自带本地目录；关闭后后台「文件存储」不再出现该厂商，已选用它的文件读写会报不支持。
STORAGE_S3_PACK_ENABLED=true
STORAGE_OSS_PACK_ENABLED=true
STORAGE_COS_PACK_ENABLED=true

# 过期文件自动清理的间隔（小时）：服务启动约 5 分钟后第一次运行，之后按这个间隔运行；默认 24，0 关闭，有效值 1 – 168。
# 清理条件与后台「执行过期清理」相同。多实例部署只在一个实例上开启（其余设 0），且各实例必须共享同一份文件存储。
FILE_ASSET_CLEANUP_INTERVAL_HOURS=24

# 支付自动补单：每 2 分钟核对一次创建于 5 分钟前到 24 小时内的待支付订单，查到已付款且订单号、金额、币种、渠道都一致时入账。
# 默认开启，设为 false 关闭。多实例部署只在一个实例上开启（其余设 false）。
PAYMENT_RECONCILE_ENABLED=true

# 站点正式访问地址（带协议），是唯一放行的跨域来源；未配置时使用管理后台「基础信息」里的网站地址。
# 开发 / 测试环境额外放行 localhost / 127.0.0.1 / [::1]。
SITE_URL=
# 反向代理信任：只有来自 127.0.0.1 / ::1 与 TRUSTED_PROXY_CIDRS 列出的地址（逗号分隔，IP 或 CIDR）的请求才读取
# X-Forwarded-For，并从右往左跳过这些可信代理、取第一个不可信的地址（前面还有 CDN 时把 CDN 网段写进来）。
# TRUST_PROXY=true 表示信任任何来源与整条代理链、取最左一项，只在外部无法绕过代理直连服务时使用。
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
# 文件安全下载：额外允许解析到保留地址段的代理主机名（逗号分隔），一般留空
SAFE_DOWNLOAD_RESERVED_PROXY_HOSTS=
# 全局配置命名空间（多站点共用一库时区分），默认 AIWeb
NAMESPACE=

# 自定义后台路径
ADMIN_SERVE_ROOT=/admin

# ---- MCP 客户端（第三方能力的唯一外接入口）----
# 静态服务器配置 JSON（单行）；管理端全局配置项 mcpServers 会按服务器 name 覆盖这里的条目。
# 形态与字段见 src/modules/mcp/mcp-config.ts 与文档站「外部接入」（site/deployment/integrations.md），例：
# MCP_SERVERS_JSON={"servers":[{"name":"docs","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer xxx"},"tools":{"deny":["delete_*"]},"identitySecret":"<共享签名密钥>"}]}
# 每次调用在 _meta["99agent/caller"] 透传当前用户身份；identitySecret 配置后带 HMAC-SHA256 签名（5 分钟有效），
# 服务端用同一密钥校验；不需要身份的服务器可加 "passIdentity": false。
MCP_SERVERS_JSON=
# stdio 传输会在本机拉起子进程，默认关闭；开启后还必须把命令的绝对路径（与配置里的 command 完全一致）列入放行清单，逗号分隔
MCP_STDIO_ENABLED=false
MCP_STDIO_COMMAND_ALLOWLIST=
# 单次 MCP 工具输出送入模型的最大字符数，超出截断
MCP_TOOL_RESULT_MAX_CHARS=48000

# ---- 用户沙箱（Docker + gVisor，见 sandbox/README.md）----
# docker（生产）：登录用户每人一台、多个对话共用，访客每个对话一台临时容器；local：无隔离的本机进程，仅开发 / 测试
SANDBOX_DRIVER=docker
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# 或用 TCP：SANDBOX_DOCKER_HOST=127.0.0.1 SANDBOX_DOCKER_PORT=2375
# 生产模式（见上方运行环境说明）固定 runsc；只有开发模式才能留空改用 runc
SANDBOX_DOCKER_RUNTIME=runsc
SANDBOX_NAME_PREFIX=99agent-sbx- # 同一实例前缀只由一个 server 管理；只能含字母、数字、点、下划线、连字符
SANDBOX_IMAGE=99agent/sandbox:latest
# 登录用户的工作区：disk = 每人一块持久磁盘（需安装宿主磁盘助手，见 sandbox/README.md「用户磁盘」）；
# tmpfs = 临时工作区。生产环境默认 disk，缺 SANDBOX_USER_DISK_ROOT 时拒绝启动；要用临时工作区须显式写 tmpfs
SANDBOX_USER_STORAGE=disk
# 与助手配置 /etc/99agent/sandbox-disk.conf 的 DISK_ROOT 相同；需要本机 Docker（Unix socket）
SANDBOX_USER_DISK_ROOT=/var/lib/99agent/sandbox-disks
# 助手路径；server 非 root 运行时经 sudo -n 调用，sudoers 白名单见 sandbox/README.md
SANDBOX_USER_DISK_COMMAND=/usr/local/sbin/99agent-sandbox-disk
# 每用户磁盘默认容量；商业包套餐档位「磁盘（MB）」可按方案覆盖，调大在下次开机时扩容
SANDBOX_USER_DISK_MB=4096
# 宿主磁盘低水位：剩余低于它时暂停所有用户磁盘的写入与执行，防止稀疏镜像把宿主盘写满
SANDBOX_USER_DISK_HOST_MIN_FREE_MB=10240
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
# egress = 受控公网代理（需要 Docker 28+ 与代理镜像）；none = 无网
SANDBOX_NETWORK_MODE=egress
SANDBOX_EGRESS_IMAGE=99agent/sandbox-egress:latest
# 可选逗号分隔域名；DENY 同时支持公网 IP，应加入本站/宿主公开地址
SANDBOX_EGRESS_ALLOW_HOSTS=
SANDBOX_EGRESS_DENY_HOSTS=
SANDBOX_EXEC_TIMEOUT_SEC=120
SANDBOX_EXEC_MAX_OUTPUT_KB=256
SANDBOX_IDLE_STOP_MINUTES=15
# 临时工作区（访客、SANDBOX_USER_STORAGE=tmpfs）tmpfs 的字节与 inode 硬上限，占用计入容器内存
SANDBOX_WORKSPACE_MAX_MB=1024
SANDBOX_WORKSPACE_MAX_INODES=100000
# 工作区所在文件系统的可用容量低水位，观测失败时拒绝写入
SANDBOX_MIN_FREE_MB=16
SANDBOX_MIN_FREE_INODES=1000
# 单 server 实例最多管理的活跃沙箱数（包括重启发现的运行容器）
SANDBOX_MAX_ACTIVE=4
# 每账号同时运行的沙箱数：登录用户固定一台，只对访客的多个对话生效
SANDBOX_MAX_ACCOUNT_ACTIVE=2
SANDBOX_TOTAL_MEMORY_MB=4096
# 临时工作区从容器创建起算的待交付恢复窗口，最大 24 小时（持久磁盘上的待交付文件随盘保留）
SANDBOX_PENDING_RETENTION_HOURS=24
# 访客是否可用沙箱工具（默认开放）。访客沙箱在闲置回收时连同工作区一起删除；同一 IP 每小时最多签发 30 个访客会话。
SANDBOX_VISITOR_ENABLED=true
# 容器 1 号进程使用 docker-init 回收僵尸进程（默认开启；改动后已有容器会因策略指纹不一致被拒绝复用，需管理员删除后重建）
SANDBOX_DOCKER_INIT=true
# local 驱动的工作区根目录
SANDBOX_LOCAL_ROOT=data/sandboxes
# 站点技能目录：其中每个含 SKILL.md 的子目录会在用户首次进入沙箱时复制到 /workspace/skills/<name>/；
# 垂直包导入命令（node dist/main vertical:import <manifest.json>）会把清单里的技能复制到这里。
SANDBOX_SITE_SKILLS_DIR=

# 本地文件资产分区预留（公开与私有存储均检查）；不是沙箱 tmpfs 水位
FILE_ASSET_LOCAL_MIN_FREE_MB=1024
FILE_ASSET_LOCAL_MIN_FREE_INODES=1000

# 浏览器标签页上的应用名
VITE_APP_TITLE = 99Agent
# 与后端同源部署，接口走 /api
VITE_APP_API_BASEURL = /api

# 构建时是否生成 sourcemap
VITE_BUILD_SOURCEMAP = false
# 部署路径（Vite 的 base）；留空时资源按相对路径加载。管理端不放在 /admin 时见部署文档
# VITE_BASE_PATH = /admin/
VITE_BASE_PATH =

# 帮助文档站点，顶栏「帮助文档」链接到这里
VITE_DOC_URL = https://docs.lightai.cloud

# 商业包菜单（支付财务）；false 时不装载，对应后端 COMMERCE_PACK_ENABLED
VITE_COMMERCE_ENABLED = true

# 内容安全包菜单（安全风控）；false 时不装载，对应后端 CONTENT_SAFETY_PACK_ENABLED
VITE_CONTENT_SAFETY_ENABLED = true

# 微信包菜单（微信配置 / Bot 通道）；false 时不装载，对应后端 WECHAT_PACK_ENABLED
VITE_WECHAT_ENABLED = true

# 登录渠道包页签（登录配置里的邮箱 / 手机号 / GitHub 页签）；false 时不展示，对应后端 EMAIL/PHONE/GITHUB_PACK_ENABLED
VITE_EMAIL_ENABLED = true
VITE_PHONE_ENABLED = true
VITE_GITHUB_ENABLED = true

# 存储包（文件存储里的 S3 / OSS / COS 选项）；false 时不展示，对应后端 STORAGE_S3/OSS/COS_PACK_ENABLED
VITE_STORAGE_S3_ENABLED = true
VITE_STORAGE_OSS_ENABLED = true
VITE_STORAGE_COS_ENABLED = true
